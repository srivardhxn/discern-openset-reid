{
 "model": {
  "name": "Discern-R50-BNNeck",
  "architecture": "ResNet-50 (last stride 1) + GeM + BNNeck",
  "embedding_dim": 2048,
  "onnx": "discern_embedder.onnx",
  "torchscript": "discern_embedder.torchscript.pt",
  "pytorch_weights": "discern_reid_r50.pt",
  "onnx_validated": true
 },
 "preprocess": {
  "input_size_hw": [
   288,
   144
  ],
  "colour": "RGB",
  "range": "float32 0..1, NCHW",
  "resize": "stretch the person crop to WxH (bilinear); no padding",
  "normalisation": "done INSIDE the exported model (ImageNet mean/std) - do not normalise again"
 },
 "embedding": {
  "l2_normalised": true,
  "similarity": "cosine (dot product)",
  "flip_tta": true,
  "tta_recipe": "e = normalize(embed(x) + embed(horizontal_flip(x)))  <- used for enrolment AND probes"
 },
 "matching": {
  "aggregation": "max",
  "aggregation_note": "identity score = mean of the top-k image similarities of that identity (max when k=1)",
  "decision": "confidence = sigmoid(coef . standardise([s1, margin, z]) + intercept); accept iff confidence > operating-point threshold; else REJECT as 'unknown'",
  "features": {
   "s1": "best identity score",
   "margin": "s1 minus runner-up identity score",
   "z": "(s1 - mean(all identity scores)) / std(all identity scores)"
  },
  "min_identities_full_calibrator": 10,
  "fallback": "s1_margin if >=2 identities, s1 if 1 identity"
 },
